# LINE Developersコンソール > チャネル基本設定 > チャネルシークレット
LINE_CHANNEL_SECRET=your_channel_secret

# LINE Developersコンソール > Messaging API設定 > チャネルアクセストークン(長期)
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token

# Anthropicのコンソール(https://console.anthropic.com)で発行したAPIキー
ANTHROPIC_API_KEY=sk-ant-...

# サーバーのポート(省略時は3000)
# PORT=3000
