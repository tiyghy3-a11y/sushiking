{
  "name": "yamalog",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "setup:local": "npm run db:migrate:local && npm run seed:local",
    "start": "npm run build && wrangler dev",
    "start:lan": "npm run build && wrangler dev --ip 0.0.0.0",
    "demo": "tsx scripts/demo-seed.ts",
    "demo:reset": "tsx scripts/demo-seed.ts --reset",
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.worker.json && tsc -p tsconfig.web.json && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply yamalog --local",
    "db:migrate": "wrangler d1 migrations apply yamalog --remote",
    "seed:coords": "tsx scripts/fetch-coords.ts",
    "seed:local": "tsx scripts/seed.ts --local",
    "seed": "tsx scripts/seed.ts --remote",
    "bulk-import": "tsx scripts/bulk-import.ts"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "exifr": "^7.1.3",
    "heic2any": "^0.0.4",
    "maplibre-gl": "^4.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "recharts": "^2.15.0",
    "sharp": "^0.33.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "wrangler": "^3.99.0"
  }
}
